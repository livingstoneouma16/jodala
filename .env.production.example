# Production configuration. Copy this file to .env.production, then replace
# every placeholder with a secret-manager value or an environment-specific value.
APP_ENV=production
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_HEX_SECRET
DATABASE_URL=postgresql://jodala:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/jodala
RATELIMIT_STORAGE_URI=redis://redis:6379/0
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://app.example.com

# Payment gateway: configure production M-Pesa Daraja credentials and set a
# publicly reachable HTTPS callback URL before enabling live STK Push.
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://app.example.com/mpesa/callback

# Optional CloudPay STK Push gateway. Change PAYMENT_GATEWAY only after its
# credentials and callback URL are configured.
PAYMENT_GATEWAY=mpesa
CLOUDPAY_ENVIRONMENT=production
CLOUDPAY_API_KEY=
CLOUDPAY_API_SECRET=
CLOUDPAY_TILL_NUMBER=
CLOUDPAY_CALLBACK_URL=https://app.example.com/mpesa/cloudpay/callback

# Passkey login: use the public HTTPS origin users open in their browser.
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_RP_NAME=Jodala Microfinance
WEBAUTHN_ORIGIN=https://app.example.com

# Scheduled background jobs
ENABLE_OVERDUE_SCHEDULER=true
OVERDUE_REMINDER_HOUR=8
OVERDUE_REMINDER_MINUTE=0
ENABLE_BACKUP_SCHEDULER=true
BACKUP_HOUR=2
BACKUP_MINUTE=0
SCHEDULER_TIMEZONE=UTC
BACKUP_DIR=backups
BACKUP_RETENTION=7
CAMPAIGN_MAX_RECIPIENTS=250

# TextSMS automatic customer notifications. Once enabled, repayment receipts,
# loan disbursements, and daily overdue reminders are sent automatically.
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SENDER_ID=
SMS_NOTIFICATIONS_ENABLED=false
# ChatGPT campaign drafting (optional)
OPENAI_API_KEY=
# Optional: defaults to gpt-5
OPENAI_CAMPAIGN_MODEL=gpt-5

# Optional durable backup storage. Install boto3 in the deployment
# environment before enabling an S3 bucket.
S3_BACKUP_BUCKET=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
