# Production configuration. Copy this file to .env.production, then replace
# every placeholder with a secret-manager value or an environment-specific value.
APP_ENV=production
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_HEX_SECRET
DATABASE_URL=postgresql://jodala:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/jodala
RATELIMIT_STORAGE_URI=redis://redis:6379/0
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://app.example.com

# Passkey login: use the public HTTPS origin users open in their browser.
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_RP_NAME=Jodala Microfinance
WEBAUTHN_ORIGIN=https://app.example.com

# Scheduled background jobs
ENABLE_OVERDUE_SCHEDULER=true
OVERDUE_REMINDER_HOUR=8
OVERDUE_REMINDER_MINUTE=0
ENABLE_BACKUP_SCHEDULER=true
BACKUP_HOUR=2
BACKUP_MINUTE=0
SCHEDULER_TIMEZONE=UTC
BACKUP_DIR=backups
BACKUP_RETENTION=7

# Optional durable backup storage. Install boto3 in the deployment
# environment before enabling an S3 bucket.
S3_BACKUP_BUCKET=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
