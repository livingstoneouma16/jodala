# Local development configuration. Copy this file to .env and replace values
# marked with a placeholder before using shared services.
APP_ENV=development
SECRET_KEY=dev-secret-change-before-production
JWT_SECRET_KEY=dev-jwt-secret-change-before-production
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/jodala
RATELIMIT_STORAGE_URI=memory://
COOKIE_SECURE=false

# Passkey login for local development
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Jodala Microfinance
WEBAUTHN_ORIGIN=http://localhost:5000

# Scheduled background jobs
ENABLE_OVERDUE_SCHEDULER=true
OVERDUE_REMINDER_HOUR=8
OVERDUE_REMINDER_MINUTE=0
ENABLE_BACKUP_SCHEDULER=false
SCHEDULER_TIMEZONE=UTC
BACKUP_DIR=backups
BACKUP_RETENTION=7
